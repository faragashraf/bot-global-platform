{
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

(frontend_site) {
	handle /backend {
		rewrite * /health
		reverse_proxy backend:8080
	}

	handle_path /backend/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv/frontend
		header /index.html Cache-Control "no-store"
		header /runtime-config.js Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}

(api_site) {
	handle /backend {
		rewrite * /health
		reverse_proxy backend:8080
	}

	handle_path /backend/* {
		reverse_proxy backend:8080
	}

	handle {
		reverse_proxy backend:8080
	}
}

http://botglobalservice.com, http://www.botglobalservice.com {
	import frontend_site
}

http://api.botglobalservice.com, http://backend.botglobalservice.com {
	import api_site
}

:80 {
	import frontend_site
}
