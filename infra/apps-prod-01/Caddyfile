:80 {
	handle /backend {
		rewrite * /health
		reverse_proxy backend:8080
	}

	handle_path /backend/* {
		reverse_proxy backend:8080
	}

	handle {
		root * /srv/frontend
		header /index.html Cache-Control "no-store"
		header /runtime-config.js Cache-Control "no-store"
		try_files {path} /index.html
		file_server
	}
}
