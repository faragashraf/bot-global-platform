<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_identity.xml" />
        <exclude domain="sharedpref" path="device_registration_credentials.xml" />
        <exclude domain="sharedpref" path="server_configuration.xml" />
        <exclude domain="sharedpref" path="signalr_connection_metadata.xml" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_identity.xml" />
        <exclude domain="sharedpref" path="device_registration_credentials.xml" />
        <exclude domain="sharedpref" path="server_configuration.xml" />
        <exclude domain="sharedpref" path="signalr_connection_metadata.xml" />
    </device-transfer>
</data-extraction-rules>
