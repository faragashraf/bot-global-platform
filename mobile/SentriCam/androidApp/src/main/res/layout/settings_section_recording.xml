<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_recording_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/settings_recording_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_quality_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_recording_quality_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_recording_quality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/settings_quality_low" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_quality_low" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_quality_standard" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_quality_standard" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_quality_high" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_quality_high" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/engine_segment_duration_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_recording_duration_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_segment_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/settings_duration_15" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_duration_15_seconds_debug" android:visibility="gone" tools:visibility="visible" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_duration_30" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_duration_30_seconds_debug" android:visibility="gone" tools:visibility="visible" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_duration_1m" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_duration_1_minute" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_duration_5m" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_duration_5_minutes" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_duration_10m" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/engine_duration_10_minutes" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_recording_audio_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_brand_secondary"
                    android:textDirection="locale" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_audio_enabled"
                    style="@style/Widget.SentriCam.Vision.SettingsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/audio_recording_title" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Healthy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_recording_storage_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_status_healthy"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_storage_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/engine_storage_loading"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Body"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_recording_storage_location"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textColor="@color/vision_text_secondary"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_storage_warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:accessibilityLiveRegion="polite"
                    android:text="@string/engine_storage_warning"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textColor="@color/vision_status_critical"
                    android:textDirection="locale"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_recording_debug_group"
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/settings_simulate_storage_warning"
                style="@style/Widget.SentriCam.Vision.SettingsSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/vision_space_12"
                android:text="@string/engine_debug_simulate_storage_warning" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
