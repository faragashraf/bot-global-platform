<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_motion_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/motion_vision_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Motion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motion_automation_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_status_motion"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/motion_automation_section_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_motion_enabled"
                    style="@style/Widget.SentriCam.Vision.SettingsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/motion_enable" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motion_sensitivity_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/motion_sensitivity_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_motion_sensitivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_sensitivity_low"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motion_sensitivity_low" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_sensitivity_medium"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motion_sensitivity_medium" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_sensitivity_high"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motion_sensitivity_high" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_sensitivity_advanced"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/motion_sensitivity_advanced" />
                </com.google.android.material.chip.ChipGroup>

                <LinearLayout
                    android:id="@+id/settings_advanced_sensitivity_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:background="@drawable/vision_background_glass"
                    android:orientation="vertical"
                    android:padding="@dimen/vision_space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/settings_advanced_sensitivity_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:gravity="center_horizontal"
                        android:text="@string/motion_sensitivity_value_default"
                        android:textAppearance="@style/TextAppearance.SentriCam.Vision.Numeric" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/settings_advanced_sensitivity_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/motion_sensitivity_slider_description"
                        android:stepSize="1"
                        android:value="50"
                        android:valueFrom="0"
                        android:valueTo="100"
                        app:haloColor="@color/vision_status_motion_container"
                        app:thumbColor="@color/vision_status_motion"
                        app:trackColorActive="@color/vision_status_motion" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/motion_timing_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:text="@string/motion_trigger_delay_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Label"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/motion_trigger_delay_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_motion_trigger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/settings_trigger_immediate" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_trigger_immediate" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_trigger_1" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_one_second" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_trigger_2" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_two_seconds" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_16"
                    android:text="@string/motion_stop_delay_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Label"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/motion_stop_delay_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_motion_hold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/settings_hold_3" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_three_seconds" android:visibility="gone" tools:visibility="visible" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_hold_5" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_five_seconds" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_hold_10" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_ten_seconds" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_hold_20" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_twenty_seconds" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_hold_30" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_thirty_seconds" />
                </com.google.android.material.chip.ChipGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_16"
                    android:text="@string/motion_cooldown_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Label"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/motion_cooldown_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_motion_cooldown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip android:id="@+id/settings_cooldown_3" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_three_seconds" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_cooldown_5" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_five_seconds" />
                    <com.google.android.material.chip.Chip android:id="@+id/settings_cooldown_10" style="@style/Widget.SentriCam.Vision.SegmentedControl" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/motion_ten_seconds" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/settings_motion_debug_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12"
            android:fontFamily="sans-serif-monospace"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_text_subtle"
            android:visibility="gone"
            tools:text="threshold · area · noise · frames"
            tools:visibility="visible" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
