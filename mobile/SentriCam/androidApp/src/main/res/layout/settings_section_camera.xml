<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_camera_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/settings_camera_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_choice_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_camera_lens_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/settings_camera_lens"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    app:chipSpacingHorizontal="@dimen/vision_space_8"
                    app:chipSpacingVertical="@dimen/vision_space_4"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_camera_rear"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_rear" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/settings_camera_front"
                        style="@style/Widget.SentriCam.Vision.SegmentedControl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/camera_front" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_camera_overlay_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_brand_secondary"
                    android:textDirection="locale" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/settings_timestamp_enabled"
                    style="@style/Widget.SentriCam.Vision.SettingsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/timestamp_overlay_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/timestamp_overlay_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
