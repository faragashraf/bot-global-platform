<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_smart_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/settings_smart_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/vision_space_8"
                android:paddingBottom="@dimen/vision_space_8">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/vision_space_16"
                    android:paddingTop="@dimen/vision_space_8"
                    android:paddingEnd="@dimen/vision_space_16"
                    android:paddingBottom="@dimen/vision_space_8"
                    android:text="@string/settings_smart_features_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_brand_secondary"
                    android:textDirection="locale" />

                <LinearLayout
                    android:id="@+id/settings_smart_features"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
