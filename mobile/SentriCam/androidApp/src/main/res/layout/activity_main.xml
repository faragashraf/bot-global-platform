<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    tools:context=".MainActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:keepScreenOn="false"
        app:implementationMode="compatible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:scaleType="fillCenter" />

    <com.ashraffarag.sentricam.recording.overlay.android.PreviewTimestampOverlayView
        android:id="@+id/preview_timestamp_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/vision_space_8"
        android:layout_marginBottom="@dimen/vision_space_8"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/recording_engine_status"
        android:layout_marginHorizontal="@dimen/vision_space_16"
        app:layout_constraintLeft_toLeftOf="@id/preview_view"
        app:layout_constraintRight_toLeftOf="@id/camera_control_rail"
        app:layout_constraintTop_toBottomOf="@id/camera_overlay_safe_top" />

    <View
        android:id="@+id/camera_top_scrim"
        android:layout_width="0dp"
        android:layout_height="@dimen/vision_camera_top_scrim_height"
        android:background="@drawable/vision_camera_top_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/camera_bottom_scrim"
        android:layout_width="0dp"
        android:layout_height="@dimen/vision_camera_bottom_scrim_height"
        android:background="@drawable/vision_camera_bottom_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/camera_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:layout_marginHorizontal="@dimen/vision_space_16"
        android:layout_marginTop="@dimen/vision_space_12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/camera_identity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
            android:textColor="@color/vision_text_primary"
            android:textDirection="locale"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/language_button"
            style="@style/Widget.SentriCam.Vision.IconAction"
            android:layout_width="@dimen/vision_touch_target"
            android:layout_height="@dimen/vision_touch_target"
            android:contentDescription="@string/language_action_content_description"
            android:layoutDirection="ltr"
            app:icon="@drawable/ic_language_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/operational_status_cluster"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/vision_space_16"
        android:layout_marginTop="@dimen/vision_space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_toolbar">

        <com.ashraffarag.sentricam.communication.signalr.android.RealtimeStatusView
            android:id="@+id/realtime_status"
            style="@style/Widget.SentriCam.Vision.CameraOverlayChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="@dimen/vision_space_8"
            android:layout_height="1dp" />

        <com.ashraffarag.sentricam.live.android.LiveStatusView
            android:id="@+id/live_status"
            style="@style/Widget.SentriCam.Vision.CameraOverlayChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.ashraffarag.sentricam.motion.android.ui.MotionStatusView
        android:id="@+id/motion_status"
        style="@style/Widget.SentriCam.Vision.CameraOverlayChip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vision_space_8"
        android:layout_marginTop="@dimen/vision_space_8"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/camera_control_rail"
        app:layout_constraintTop_toBottomOf="@id/operational_status_cluster" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/time_validation_panel"
        style="@style/Widget.SentriCam.Vision.StatusBanner.Warning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vision_space_16"
        android:layout_marginTop="@dimen/vision_space_8"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/motion_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/vision_space_12"
            android:paddingEnd="@dimen/vision_space_4"
            android:paddingVertical="@dimen/vision_space_4">

            <TextView
                android:id="@+id/time_validation_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/time_validation_action"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/time_validation_open_settings"
                android:text=""
                app:icon="@drawable/ic_date_time_24" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/camera_control_rail"
        style="@style/Widget.SentriCam.Vision.CameraControlRail"
        android:layout_width="@dimen/vision_camera_control_rail_width"
        android:layout_height="@dimen/vision_camera_control_rail_height"
        android:layout_margin="@dimen/vision_space_12"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/recording_engine_status"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camera_overlay_safe_top"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/vision_space_8"
            android:paddingTop="@dimen/vision_space_8"
            android:paddingEnd="@dimen/vision_space_8"
            android:paddingBottom="@dimen/vision_space_8">

            <FrameLayout
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_camera_zoom_track_length">

                <com.google.android.material.slider.Slider
                    android:id="@+id/zoom_slider"
                    android:layout_width="@dimen/vision_camera_zoom_track_length"
                    android:layout_height="@dimen/vision_touch_target"
                    android:layout_gravity="center"
                    android:layoutDirection="ltr"
                    android:rotation="-90"
                    android:stepSize="0"
                    android:value="1"
                    android:valueFrom="1"
                    android:valueTo="4"
                    app:haloColor="@color/vision_brand_primary_container"
                    app:labelBehavior="gone"
                    app:thumbColor="@color/vision_brand_primary"
                    app:trackColorActive="@color/vision_brand_primary"
                    app:trackColorInactive="@color/vision_border" />
            </FrameLayout>

            <TextView
                android:id="@+id/zoom_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/vision_space_4"
                android:fontFamily="sans-serif-monospace"
                android:text="@string/camera_zoom_value_default"
                android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
                android:textColor="@color/vision_text_secondary"
                android:textDirection="ltr" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flash_button"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:layout_marginTop="@dimen/vision_space_8"
                android:contentDescription="@string/camera_flash_off"
                app:icon="@drawable/ic_flash_off_24" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.ashraffarag.sentricam.recording.engine.android.ui.RecordingEngineStatusView
        android:id="@+id/recording_engine_status"
        style="@style/Widget.SentriCam.Vision.CameraOverlayChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vision_space_8"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/recording_readout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/recording_readout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/vision_space_8"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/recording_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/recording_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="@dimen/vision_camera_readout_max_width"
            android:maxLines="2"
            android:text="@string/recording_camera_not_ready"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textDirection="locale" />

        <TextView
            android:id="@+id/recording_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/recording_duration_zero"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Numeric" />

        <TextView
            android:id="@+id/recording_segment_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-monospace"
            android:text="@string/recording_segment_duration_zero"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_text_subtle" />

        <TextView
            android:id="@+id/recording_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:gravity="center"
            android:maxWidth="@dimen/vision_camera_readout_max_width"
            android:maxLines="1"
            android:text=""
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_text_subtle"
            android:textDirection="locale"
            android:textIsSelectable="true"
            android:visibility="gone" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recording_panel"
        style="@style/Widget.SentriCam.Vision.CameraControlDock"
        android:layout_width="0dp"
        android:layout_height="@dimen/vision_camera_dock_height"
        android:layout_marginHorizontal="@dimen/vision_space_16"
        android:layout_marginBottom="@dimen/recording_panel_bottom_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="@dimen/vision_camera_dock_max_width">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/recording_button"
                style="@style/Widget.SentriCam.Vision.CameraShutter"
                android:layout_width="@dimen/vision_camera_shutter_size"
                android:layout_height="@dimen/vision_camera_shutter_size"
                android:adjustViewBounds="false"
                android:contentDescription="@string/recording_start"
                android:enabled="false"
                app:srcCompat="@drawable/vision_camera_shutter_inner"
                app:tint="@color/vision_action_recording_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/camera_switch_button"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/camera_switch_to_front"
                android:visibility="gone"
                app:icon="@drawable/ic_flip_camera_24"
                app:layout_constraintBottom_toBottomOf="@id/recording_button"
                app:layout_constraintEnd_toStartOf="@id/settings_button"
                app:layout_constraintTop_toTopOf="@id/recording_button"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                style="@style/Widget.SentriCam.Vision.IconAction.Prominent"
                android:layout_width="@dimen/vision_prominent_icon_action_size"
                android:layout_height="@dimen/vision_prominent_icon_action_size"
                android:contentDescription="@string/app_settings_title"
                app:icon="@drawable/ic_settings_24"
                app:layout_constraintBottom_toBottomOf="@id/recording_button"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/recording_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recordings_button"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/library_title"
                app:icon="@drawable/ic_video_library_24"
                app:layout_constraintBottom_toBottomOf="@id/recording_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/recording_button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/motion_settings_button"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/motion_accessibility_disabled"
                app:icon="@drawable/ic_motion_24"
                app:iconTint="@color/motion_off"
                app:layout_constraintBottom_toBottomOf="@id/recording_button"
                app:layout_constraintStart_toEndOf="@id/recordings_button"
                app:layout_constraintTop_toTopOf="@id/recording_button"
                app:strokeColor="@color/motion_off"
                app:strokeWidth="@dimen/vision_stroke_thin" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/status_panel"
        style="@style/Widget.SentriCam.Vision.StatusBanner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vision_space_24"
        android:layout_marginBottom="@dimen/vision_space_8"
        app:layout_constraintBottom_toTopOf="@id/recording_readout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/camera_control_rail">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/vision_space_16">

            <TextView
                android:id="@+id/status_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/camera_starting"
                android:textAppearance="@style/TextAppearance.SentriCam.Vision.Body"
                android:textDirection="locale" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/status_action"
                style="@style/Widget.SentriCam.Vision.PrimaryAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vision_space_12"
                android:text="@string/camera_retry"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/first_run_panel"
        style="@style/Widget.SentriCam.Vision.CameraOverlayChip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/vision_space_16"
        android:layout_marginTop="@dimen/vision_space_8"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/motion_status">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/vision_space_12"
            android:paddingVertical="@dimen/vision_space_4">

            <ImageView
                android:layout_width="@dimen/vision_icon_size_medium"
                android:layout_height="@dimen/vision_icon_size_medium"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_hub_24"
                app:tint="@color/vision_brand_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/vision_space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/first_run_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status" />

                <TextView
                    android:id="@+id/first_run_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/first_run_pairing_message"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/first_run_manual"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/pairing_manual_setup"
                android:text=""
                app:icon="@drawable/ic_tune_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/first_run_scan"
                style="@style/Widget.SentriCam.Vision.IconAction"
                android:layout_width="@dimen/vision_touch_target"
                android:layout_height="@dimen/vision_touch_target"
                android:contentDescription="@string/pairing_scan_action"
                android:text=""
                app:backgroundTint="@color/vision_brand_primary"
                app:icon="@drawable/ic_qr_scan_24"
                app:iconTint="@color/vision_on_brand"
                app:strokeColor="@color/vision_brand_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/camera_overlay_safe_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierAllowsGoneWidgets="false"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="camera_toolbar,operational_status_cluster,motion_status,time_validation_panel,first_run_panel" />

</androidx.constraintlayout.widget.ConstraintLayout>
