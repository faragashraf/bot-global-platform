<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_system_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/settings_system_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Healthy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_connection_health_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_status_healthy"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_operating_mode"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_hub_status"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/settings_connectivity_value"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_battery_value"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/settings_storage_value"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_hub_connection_card"
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_registration_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_connection_registration_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/settings_server_url_container"
                    style="@style/Widget.SentriCam.Vision.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:hint="@string/device_server_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settings_server_url_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SentriCam.Vision.Body"
                        android:textDirection="ltr" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/settings_registration_status"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_registration_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/settings_registration_server_device_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/settings_registration_token_expiration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_registration_last_attempt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_registration_last_connection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_scan_hub_qr"
                    style="@style/Widget.SentriCam.Vision.PrimaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_16"
                    android:text="@string/connect_hub_scan_qr" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_register_device"
                    style="@style/Widget.SentriCam.Vision.SecondaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/device_register" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_test_connection"
                    style="@style/Widget.SentriCam.Vision.SecondaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/device_test_connection" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_forget_registration"
                    style="@style/Widget.SentriCam.Vision.DestructiveAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:text="@string/device_forget_registration" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_realtime_card"
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/signalr_connection_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_brand_secondary"
                    android:textDirection="locale" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:text="@string/settings_connection_realtime_summary"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_signalr_state"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_signalr_connection_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_signalr_server_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_signalr_last_heartbeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_signalr_reconnect_attempts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_4"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_signalr_force_reconnect"
                    style="@style/Widget.SentriCam.Vision.SecondaryAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:text="@string/signalr_force_reconnect" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:text="@string/monitoring_foreground_limitation"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
                    android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
