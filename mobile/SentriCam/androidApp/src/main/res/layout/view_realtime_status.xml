<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/vision_space_12"
    android:paddingVertical="@dimen/vision_space_4">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/vision_compact_control_height"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/realtime_status_icon"
            android:layout_width="@dimen/vision_icon_size_small"
            android:layout_height="@dimen/vision_icon_size_small"
            android:importantForAccessibility="yes"
            android:src="@drawable/ic_hub_24"
            app:tint="@color/vision_status_offline" />

        <TextView
            android:id="@+id/realtime_status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/vision_space_8"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:text="@string/signalr_connecting"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_brand_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/realtime_reconnect"
            style="@style/Widget.SentriCam.Vision.IconAction"
            android:layout_width="@dimen/vision_touch_target"
            android:layout_height="@dimen/vision_touch_target"
            android:contentDescription="@string/realtime_reconnect_now"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_refresh_24" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/realtime_detail_toggle"
            style="@style/Widget.SentriCam.Vision.IconAction"
            android:layout_width="@dimen/vision_touch_target"
            android:layout_height="@dimen/vision_touch_target"
            android:contentDescription="@string/realtime_show_details"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_info_24" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/realtime_status_detail_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/realtime_status_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_text_secondary" />

        <TextView
            android:id="@+id/realtime_status_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Status"
            android:textColor="@color/vision_text_secondary"
            android:textIsSelectable="true" />
    </LinearLayout>

</LinearLayout>
