<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/vision_background_primary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/vision_space_16"
        android:paddingTop="@dimen/vision_space_16"
        android:paddingEnd="@dimen/vision_space_16"
        android:paddingBottom="@dimen/vision_space_32">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_device_title"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.ScreenTitle"
            android:textDirection="locale" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_4"
            android:text="@string/settings_device_summary"
            android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting"
            android:textDirection="locale" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_device_identity_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.SentriCam.Vision.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_12"
                    android:hint="@string/device_friendly_name">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/settings_device_friendly_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="64"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.SentriCam.Vision.Body"
                        android:textDirection="locale" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Healthy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_device_health_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_status_healthy"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_device_battery"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite"
                    tools:text="البطارية: 82% · غير متصل بالشاحن" />

                <TextView
                    android:id="@+id/settings_device_storage"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    tools:text="مساحة التخزين المتاحة: 18 GB" />

                <TextView
                    android:id="@+id/settings_device_camera"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    tools:text="الكاميرا: جاهزة · العدسة خلفية · 2 متاحة" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_device_operations_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_device_monitoring"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_device_recording"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" />

                <TextView
                    android:id="@+id/settings_device_motion"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SentriCam.Vision.SettingsSection.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_device_capabilities_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_brand_secondary"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_device_capabilities"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_device_details_toggle"
            style="@style/Widget.SentriCam.Vision.SecondaryAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_12"
            android:text="@string/settings_device_show_details"
            android:contentDescription="@string/settings_device_show_details"
            app:icon="@drawable/ic_info_24" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_device_technical_details"
            style="@style/Widget.SentriCam.Vision.SettingsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vision_space_8"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/vision_space_16">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_device_technical_section_title"
                    android:textAppearance="@style/TextAppearance.SentriCam.Vision.SectionTitle"
                    android:textColor="@color/vision_text_secondary"
                    android:textDirection="locale" />

                <TextView
                    android:id="@+id/settings_device_id"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/vision_space_8"
                    android:textIsSelectable="true" />

                <TextView
                    android:id="@+id/settings_device_version"
                    style="@style/Widget.SentriCam.Vision.HealthRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vision_space_8" android:text="@string/device_pairing_coming_soon" android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" android:textDirection="locale" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vision_space_8" android:text="@string/device_remote_coming_soon" android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" android:textDirection="locale" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vision_space_8" android:text="@string/device_dashboard_coming_soon" android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" android:textDirection="locale" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vision_space_8" android:text="@string/device_cloud_coming_soon" android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" android:textDirection="locale" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/vision_space_8" android:text="@string/device_webrtc_coming_soon" android:textAppearance="@style/TextAppearance.SentriCam.Vision.Supporting" android:textDirection="locale" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
