{
  "ConnectionStrings": {
    "SentriCam": ""
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "SentriCam.Server",
      "Audience": "SentriCam.Clients",
      "SigningKey": "",
      "DevelopmentOperatorTokenLifetimeMinutes": 10,
      "DevelopmentOperatorSubject": "sentricam-dev-operator",
      "DevelopmentOperatorDisplayName": "Local Development Operator",
      "AccessTokenLifetimeMinutes": 60
    }
  },
  "RecordingStorage": {
    "RootPath": "data/recordings",
    "MaximumUploadBytes": 4294967296,
    "FfmpegPath": "",
    "ThumbnailWidth": 640,
    "ThumbnailHeight": 360,
    "ThumbnailJpegQuality": 3,
    "ThumbnailTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning"
    }
  },
  "AllowedHosts": "*"
}
