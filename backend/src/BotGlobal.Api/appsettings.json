{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "BootstrapAdmin": {
      "Enabled": false
    }
  },
  "Notifications": {
    "DefaultCampaignLifetimeDays": 28,
    "MinimumCampaignLifetimeDays": 1,
    "MaximumCampaignLifetimeDays": 28,
    "Worker": {
      "BatchSize": 100,
      "PollIntervalSeconds": 10,
      "LeaseSeconds": 120,
      "MaxParallelDeliveries": 8
    },
    "Retry": {
      "InitialDelaySeconds": 30,
      "MaximumDelayMinutes": 60
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
