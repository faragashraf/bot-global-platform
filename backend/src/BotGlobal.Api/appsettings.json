{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Identity": {
    "BootstrapAdmin": {
      "Enabled": false
    }
  },
  "Notifications": {
    "DefaultCampaignLifetimeDays": 28,
    "MinimumCampaignLifetimeDays": 1,
    "MaximumCampaignLifetimeDays": 28,
    "Worker": {
      "BatchSize": 100,
      "PollIntervalSeconds": 10,
      "LeaseSeconds": 120,
      "MaxParallelDeliveries": 8
    },
    "Retry": {
      "InitialDelaySeconds": 30,
      "MaximumDelayMinutes": 60
    },
    "PushProviders": {
      "DefaultTimeToLiveDays": 3,
      "Providers": []
    }
  },
  "Firebase": {
    "Enabled": false,
    "ApplicationId": "00000000-0000-0000-0000-000000000000",
    "ConfigurationReference": "",
    "ProjectId": "",
    "CredentialPath": "",
    "Profiles": []
  },
  "FamilyGames": {
    "VersionPolicy": {
      "Android": {
        "LatestVersion": "0.1.0",
        "MinimumSupportedVersion": "0.1.0"
      },
      "Ios": {
        "LatestVersion": "0.1.0",
        "MinimumSupportedVersion": "0.1.0"
      }
    },
    "Invitations": {
      "LifetimeMinutes": 10,
      "DeepLinkBase": "familygames://invite"
    }
  },
  "Nqrb": {
    "VersionPolicy": {
      "Android": {
        "LatestVersion": "0.2.5",
        "MinimumSupportedVersion": "0.2.5",
        "Message": "يتوفر تحديث جديد لتطبيق نقرب.",
        "StoreDestination": "https://play.google.com/store/apps/details?id=com.botglobal.nqrb"
      }
    }
  },
  "Games": {
    "Voice": {
      "Ice": {
        "StunUrls": [
          "stun:stun.cloudflare.com:3478",
          "stun:stun.l.google.com:19302"
        ],
        "TurnUrls": [],
        "CredentialLifetimeMinutes": 60
      },
      "Consent": {
        "RequestLifetimeSeconds": 30
      }
    }
  },
  "Calling": {
    "Ice": {
      "StunUrls": [
        "stun:stun.cloudflare.com:3478",
        "stun:stun.l.google.com:19302"
      ],
      "TurnUrls": [],
      "CredentialLifetimeMinutes": 60
    }
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://faragashraf.github.io"
    ]
  }
}
